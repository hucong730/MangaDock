# Docker Compose database and queue
DATABASE_URL=postgresql+asyncpg://mangadock:mangadock@postgres:5432/mangadock
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=mangadock
POSTGRES_PASSWORD=mangadock
POSTGRES_DB=mangadock
MANGADOCK_LLM_MODE=fake
MANGADOCK_IMAGE_MODE=fake
MANGADOCK_VIDEO_MODE=fake
MANGADOCK_TTS_MODE=fake
MANGADOCK_MAX_NOVEL_CHARS=120000
ASSET_ROOT=/data
COMFYUI_TEMPLATE_DIR=/app/packages/providers/comfyui/templates
COMFYUI_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
EDGE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_MAP={}
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
VIDEO_PROVIDER_TIMEOUT_S=300
VIDEO_MAX_CONCURRENCY=2
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
SUBTITLE_FONT=Noto Sans CJK SC
SUBTITLE_FONT_SIZE=24
SUBTITLE_ALIGNMENT=2
SUBTITLE_OUTLINE=2

# OpenAI-compatible provider (never commit a real API key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=example-model
